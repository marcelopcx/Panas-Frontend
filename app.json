{
  "expo": {
    "name": "Panas",
    "slug": "panas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "panas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C5BA2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.panas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2C5BA2"
      },
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para cambiar la foto de perfil.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar una foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2C5BA2",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "expo-router": {
      "appRoot": "src/app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "812f4916-2a17-43a1-974a-acabcecf9923"
      }
    },
    "owner": "marceloperoz0"
  }
}
