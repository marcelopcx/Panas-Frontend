{
  "expo": {
    "name": "Panas",
    "slug": "panas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/background.avif",
    "scheme": "panas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/background.avif",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.panas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/background.avif",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/background.avif"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para cambiar la foto de perfil.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar una foto de perfil."
        }
      ]
    ],
    "expo-router": {
      "appRoot": "src/app"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
